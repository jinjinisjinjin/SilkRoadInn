  "stories": [
    {
      "id": "story_arrival",
      "title": "第一缕炉烟",
      "speaker": "掌柜",
      "npcId": "keeper_portrait",
      "unlock": {
        "always": true
      },
      "text": "爷爷留下的食单缺了大半，流沙驿的炉火却还没灭。先接下近处旅人的小单，把这间老驿站重新热起来。"
    },
    {
      "id": "story_local_help",
      "title": "门前有客",
      "speaker": "敦煌女店客",
      "npcId": "npc_dunhuang_woman",
      "unlock": {
        "completedOrderIds": [
          "order_011_dunhuang_woman_lubing"
        ]
      },
      "text": "你这炉饼有旧驿站的味道。门帘若换亮些，路过的人远远就知道这里还开着门。"
    },
    {
      "id": "story_kitchen_repair",
      "title": "后厨小修",
      "speaker": "城外农户",
      "npcId": "npc_farmer",
      "unlock": {
        "completedRepairs": [
          "tutorial_complete"
        ],
        "completedOrderIds": [
          "order_011_dunhuang_woman_lubing"
        ]
      },
      "text": "案板稳了，炉膛也顺了。再把后厨分出干湿两处，往后做奶食、香料饼才不乱。"
    },
    {
      "id": "story_codex_phase",
      "title": "食单有痕",
      "speaker": "佛寺女施主",
      "npcId": "npc_temple_donor",
      "unlock": {
        "completedRepairs": [
          "kitchen_repair"
        ],
        "completedOrderIds": [
          "order_005_monk_humabing"
        ]
      },
      "text": "食谱记下来，不只是为了买卖。许多人走过沙州，只留下一点吃食和话音，也该有人替他们存着。"
    },
    {
      "id": "story_lv1_complete",
      "title": "炉火重明",
      "speaker": "佛寺女施主",
      "npcId": "npc_temple_donor",
      "unlock": {
        "completedRepairs": [
          "codex_first_phase"
        ]
      },
      "text": "食单亮在墙上，炉火稳在后厨，流沙驿终于能让每一位赶路人知道：这里有一处可以坐下吃饭的地方。"
    }
  ],
