{
  "name": "silkroadinn-mobile",
  "private": true,
  "version": "0.1.8",
  "description": "Android installation project for the verified SilkRoadInn web game",
  "scripts": {
    "build:web": "node ../../game/playable-v0.1/scripts/build-production.mjs",
    "sync:android": "npm run build:web && cap sync android",
    "open:android": "cap open android",
    "build:android": "npm run sync:android && node scripts/build-android.mjs",
    "build:android:offline": "npm run sync:android && node scripts/build-android.mjs --offline"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
